<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title> URL Shortener</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      background: #07070f;
      display: flex;
      flex-direction: column;
      font-family: 'Sora', sans-serif;
      color: #eceaf8;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: radial-gradient(rgba(140,100,255,0.12) 1px, transparent 1px);
      background-size: 32px 32px;
      pointer-events: none;
      z-index: 0;
    }

    body::after {
      content: '';
      position: fixed;
      top: -120px; right: -120px;
      width: 520px; height: 520px;
      background: radial-gradient(circle, rgba(124,58,237,0.22) 0%, transparent 65%);
      pointer-events: none;
      z-index: 0;
    }

    nav {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 28px 60px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .logo { display: flex; align-items: center; gap: 12px; }

    .logo-icon {
      width: 38px; height: 38px;
      background: #7c3aed;
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
    }

    .logo-icon svg { width: 20px; height: 20px; }

    .logo-text { font-size: 20px; font-weight: 800; letter-spacing: 0.02em; }
    .logo-text span { color: #7c3aed; }

    .badge {
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      background: rgba(124,58,237,0.14);
      border: 1px solid rgba(124,58,237,0.32);
      color: #a78bfa;
      padding: 5px 14px;
      border-radius: 20px;
      letter-spacing: 0.07em;
    }

    .hero {
      position: relative;
      z-index: 1;
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px 24px 40px;
    }

    .hero-tag {
      font-family: 'Space Mono', monospace;
      font-size: 12px;
      color: #7c3aed;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      margin-bottom: 24px;
    }

    h1 {
      font-size: clamp(56px, 9vw, 100px);
      font-weight: 600;
      line-height: 1.0;
      letter-spacing: -0.03em;
      color: #eceaf8;
      margin-bottom: 20px;
    }

    h1 .accent {
    display: block;
    margin-top: 10px;
    background: linear-gradient(120deg, #7c3aed 10%, #c084fc 100%);
    background-clip: text;
    -webkit-text-fill-color: transparent;
    }

    .hero-sub {
    font-size: 21px;
    color: #7a7694;
    max-width: 620px;
    line-height: 1.5;
    margin-bottom: 54px;
    }

    .form-wrap { width: 100%; max-width: 900px; }

    .input-row {
      display: flex;
      align-items: stretch;
      background: rgba(255,255,255,0.04);
      border: 1.5px solid rgba(255,255,255,0.1);
      border-radius: 16px;
      overflow: hidden;
      transition: border-color 0.25s, box-shadow 0.25s;
      height: 68px;
    }

    .input-row:focus-within {
      border-color: rgba(124,58,237,0.7);
      box-shadow: 0 0 0 4px rgba(124,58,237,0.13);
    }

    .url-prefix {
      font-family: 'Space Mono', monospace;
      font-size: 13px;
      color: #4a4760;
      padding: 0 18px;
      display: flex;
      align-items: center;
      border-right: 1px solid rgba(255,255,255,0.07);
      background: rgba(255,255,255,0.02);
      white-space: nowrap;
      flex-shrink: 0;
    }

    input[type="text"] {
      flex: 1;
      min-width: 0;
      background: transparent;
      border: none;
      outline: none;
      padding: 0 20px;
      font-family: 'Space Mono', monospace;
      font-size: 14px;
      color: #eceaf8;
      caret-color: #7c3aed;
    }

    input[type="text"]::placeholder { color: #2e2b3e; }

    button[type="submit"] {
      flex-shrink: 0;
      background: #7c3aed;
      border: none;
      color: #fff;
      padding: 0 36px;
      font-family: 'Syne', sans-serif;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.03em;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      white-space: nowrap;
    }

    button[type="submit"]:hover { background: #6d28d9; }
    button[type="submit"]:active { transform: scale(0.98); }

    .result-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      background: rgba(124,58,237,0.09);
      border: 1.5px solid rgba(124,58,237,0.28);
      border-radius: 14px;
      padding: 20px 26px;
      margin-top: 20px;
      text-align: left;
      animation: slideDown 0.35s cubic-bezier(0.16,1,0.3,1);
    }

    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .result-info { min-width: 0; flex: 1; }

    .result-label {
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      color: #5a5770;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 6px;
    }

    .result-url {
      font-family: 'Space Mono', monospace;
      font-size: 17px;
      color: #a78bfa;
      font-weight: 700;
      word-break: break-all;
      text-decoration: none;
    }

    .result-url:hover { text-decoration: underline; }

    .copy-btn {
      flex-shrink: 0;
      background: rgba(124,58,237,0.18);
      border: 1px solid rgba(124,58,237,0.42);
      color: #a78bfa;
      padding: 11px 24px;
      border-radius: 10px;
      font-family: 'Space Mono', monospace;
      font-size: 12px;
      cursor: pointer;
      transition: background 0.2s;
      white-space: nowrap;
    }

    .copy-btn:hover { background: rgba(124,58,237,0.32); }

    @media (max-width: 600px) {
      nav { padding: 20px 24px; }
      h1 { font-size: 48px; }
      .hero { padding: 60px 20px 40px; }
      .hero-sub { font-size: 15px; margin-bottom: 40px; }
      .input-row { height: auto; flex-direction: column; border-radius: 14px; }
      .url-prefix { display: none; }
      input[type="text"] { padding: 18px 16px; font-size: 13px; }
      button[type="submit"] { width: 100%; padding: 18px; font-size: 14px; border-radius: 0 0 12px 12px; }
      .result-banner { flex-direction: column; align-items: flex-start; }
      .copy-btn { width: 100%; text-align: center; }
    }
  </style>
</head>
<body>

  <nav>
    <div class="logo">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
      </div>
      <span class="logo-text">ClipURL</span>
    </div>
    <div class="badge">v1.0.0</div>
  </nav>

  <section class="hero">
    <p class="hero-tag">URL Shortener</p>

    <h1>
      Long URLs,
      <span class="accent">Instantly Simplified.</span>
    </h1>

    <p class="hero-sub">
      Paste any long URL and get a clean,<br />trackable short link in one click.
    </p>

    <div class="form-wrap">
      <form action="/url" method="POST" autocomplete="off">
        <div class="input-row">
          <span class="url-prefix">https://</span>
          <input
            type="text"
            name="url"
            placeholder="your-very-long-url.com/paste/here"
            required
          />
          <button type="submit">Shorten &rarr;</button>
        </div>
      </form>

      <% if (locals.id) { %>
        <div class="result-banner">
          <div class="result-info">
            <div class="result-label">Your short link is ready</div>
            <a class="result-url" id="shortUrl" href="/<%= id %>" target="_blank" rel="noopener">
              http://<%= locals.host || localhost:8001 %>/<%= id %>
            </a>
          </div>
          <button class="copy-btn" type="button" onclick="copyShort()">copy</button>
        </div>
      <% } %>
    </div>
  </section>

  <script>
    function copyShort() {
      var el = document.getElementById('shortUrl');
      if (!el) return;
      navigator.clipboard.writeText(el.textContent.trim()).then(function () {
        var btn = document.querySelector('.copy-btn');
        btn.textContent = 'copied!';
        btn.style.color = '#34d399';
        btn.style.borderColor = 'rgba(52,211,153,0.4)';
        setTimeout(function () {
          btn.textContent = 'copy';
          btn.style.color = '';
          btn.style.borderColor = '';
        }, 1800);
      });
    }
  </script>
</body>
</html>
